# Copy to .env and fill in. Never commit .env.

# --- PayPal (Sandbox only). Leave both empty to use the built-in simulated PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from developer.paypal.com > Apps > your app > Webhooks (needed to verify webhook signatures)
PAYPAL_WEBHOOK_ID=

# --- LLM (optional). Without any key the agents use deterministic rule-based parsing.
# auto = Gemini if GEMINI_API_KEYS is set, else OpenAI if OPENAI_API_KEY is set, else none.
LLM_PROVIDER=auto

# Google Gemini - free API keys from https://aistudio.google.com/apikey
# Several keys may be given, comma-separated; they are rotated when one hits the free-tier rate limit.
# Note: on the free tier Google may use prompts to improve its products. CHECKMATE only sends the
# shopping request text and merchant policy text - never payment details.
GEMINI_API_KEYS=
# Tried in order; a model that is unavailable (404) falls through to the next.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash
# Free tier allows only a few requests per minute, so keep concurrency low.
GEMINI_MAX_CONCURRENCY=2
LLM_TIMEOUT_SECONDS=15

# OpenAI (alternative provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Environment. In production the API refuses to start with default secrets or demo tokens,
# and demo controls (offer price changes) are disabled.
APP_ENV=development
# Lets the API change demo offer prices (to demonstrate the Monitoring Agent). Off by default.
DEMO_CONTROLS_ENABLED=false
# Background jobs: payment sweeper + scheduled offer monitoring.
JOBS_ENABLED=true
JOBS_INTERVAL_SECONDS=60

# --- Database. Default is a local SQLite file; docker-compose sets PostgreSQL.
# DATABASE_URL=postgresql+psycopg://checkmate:checkmate@localhost:5432/checkmate

# --- URLs
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Demo access token(s), user:token pairs. Set the same token as NEXT_PUBLIC_DEMO_TOKEN in frontend/.env.local.
# Replace with a real identity provider before letting anyone else use CHECKMATE.
CHECKMATE_DEMO_USERS=shopper:replace-with-a-long-random-token

# --- Secrets: CHANGE THESE outside local development.
PAYMENT_AUTHORIZATION_SECRET=change-me-payment-authorization-secret
MOCK_WEBHOOK_SECRET=change-me-mock-webhook-secret

CONTRACT_TTL_HOURS=24
AGENT_TIMEOUT_SECONDS=45
RATE_LIMIT_PER_MINUTE=240
