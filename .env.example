# Copy to .env and fill in. Never commit .env.

# --- PayPal (Sandbox only). Leave both empty to use the built-in simulated PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from developer.paypal.com > Apps > your app > Webhooks (needed to verify webhook signatures)
PAYPAL_WEBHOOK_ID=

# --- Real product search (required to find products). Google Shopping via SerpAPI covers thousands of
# real stores. Free key (250 searches/month): https://serpapi.com/users/sign_up
SERPAPI_KEY=
# Results are cached for this long to save searches (SerpAPI also caches for 1 hour, free of charge).
SERPAPI_CACHE_SECONDS=3600
# The fictional demo store (for tests / PayPal checkout demonstration only). Never shown unless enabled.
DEMO_CATALOG_ENABLED=false

# --- LLM (optional). Without any key the agents use deterministic rule-based parsing.
# auto = Gemini if GEMINI_API_KEYS is set, else OpenAI if OPENAI_API_KEY is set, else none.
LLM_PROVIDER=auto

# Google Gemini - free API keys from https://aistudio.google.com/apikey
# Several keys may be given, comma-separated; they are rotated when one hits the free-tier rate limit.
# Note: on the free tier Google may use prompts to improve its products. CHECKMATE only sends the
# shopping request text and merchant policy text - never payment details.
GEMINI_API_KEYS=
# Tried in order; a model that is unavailable (404) falls through to the next.
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-flash-latest
# Free tier allows only a few requests per minute, so keep concurrency low.
GEMINI_MAX_CONCURRENCY=2
LLM_TIMEOUT_SECONDS=15

# OpenAI (alternative provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Environment. In production the API refuses to start with default secrets or demo tokens,
# and demo controls (offer price changes) are disabled.
APP_ENV=development
# Lets the API change demo offer prices (to demonstrate the Monitoring Agent). Off by default.
DEMO_CONTROLS_ENABLED=false
# Background jobs: payment sweeper + scheduled offer monitoring.
JOBS_ENABLED=true
JOBS_INTERVAL_SECONDS=60

# --- Database. Default is a local SQLite file; docker-compose sets PostgreSQL.
# DATABASE_URL=postgresql+psycopg://checkmate:checkmate@localhost:5432/checkmate

# --- URLs
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Accounts: people sign up with email + password (stored as scrypt hashes; HttpOnly session cookie).
ALLOW_REGISTRATION=true
SESSION_DAYS=7
# Turn on when serving over HTTPS (always on in production).
SECURE_COOKIES=false
# Optional bearer tokens for scripts/tests only (user:token pairs). Never use public example tokens.
# CHECKMATE_DEMO_USERS=script:a-long-random-token

# --- Secrets. Leave blank to auto-generate a random secret at startup (recommended).
PAYMENT_AUTHORIZATION_SECRET=
MOCK_WEBHOOK_SECRET=
# Signs approvals and passports. Leave blank to create backend/.keys/signing.key on first run.
# Keep it outside the database and back it up: without it old passports can't be verified.
SIGNING_KEY=

CONTRACT_TTL_HOURS=24
AGENT_TIMEOUT_SECONDS=45
RATE_LIMIT_PER_MINUTE=240
